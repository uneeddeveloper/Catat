# TiDB Cloud (MySQL-compatible connection string)
TIDB_DATABASE_URL=mysql://user:password@host:4000/database

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
# URL webhook produksi (Vercel). Setiap `npm run dev` nyala, dipakai untuk
# menegaskan ulang webhook production tetap aktif - jadi bot Telegram tetap
# jalan walau project lokal ditutup. Kosongkan kalau belum deploy.
TELEGRAM_WEBHOOK_URL=https://<domain-vercel-anda>/api/telegram/webhook

# Isi "1" HANYA saat mau tes balasan bot langsung dari lokal (long polling).
# Selama polling aktif, webhook production OTOMATIS NONAKTIF (Telegram cuma
# izinkan salah satu mode). Matikan/hapus lagi kalau sudah selesai testing -
# start ulang `npm run dev` tanpa flag ini akan otomatis pasang balik webhook.
TELEGRAM_DEV_POLLING=

# OpenAI-compatible (dipakai untuk baca struk & parsing teks pengeluaran)
# Default ke OpenAI langsung. Untuk pakai provider lain (mis. Sumopod), isi
# OPENAI_BASE_URL dengan base URL provider tsb dan OPENAI_MODEL dengan nama model-nya.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=

# Cloudflare R2 (penyimpanan foto struk)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=catat-receipts
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Sesi panel admin (nuxt-auth-utils) - string acak, minimal 32 karakter
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string

# Fonnte (WA gateway) - ambil token device di dashboard Fonnte
FONNTE_API_TOKEN=...
FONNTE_WEBHOOK_SECRET=change-me-to-a-random-string
